{
  "name": "beer-visuals",
  "version": "1.1.0",
  "description": "BEER VISUALS — Minecraft 1.16.5 launcher with beer_visuals",
  "main": "main.js",
  "author": "you",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.4"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.beer.client",
    "productName": "BeerVisuals",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "resources/mods",
        "to": "mods"
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "BeerVisuals.exe"
    }
  }
}
